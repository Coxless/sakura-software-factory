{
  "name": "sakura-software-factory",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "check": "biome ci . && tsc --noEmit && vitest run",
    "fix": "biome check --write .",
    "lint": "biome ci .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node src/main.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node src/migrate.ts",
    "sandbox:build": "docker build -t factory-sandbox:latest sandbox"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "execa": "10.2.1",
    "pino": "10.4.0",
    "smol-toml": "1.9.1",
    "typebox": "1.4.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "13.2.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
