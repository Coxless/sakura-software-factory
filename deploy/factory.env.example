# /etc/sakura-factory/factory.env のひな形。このファイルは root:factory、0640 にする。
# 値はリポジトリに書かず、VPS 上でだけ書く。説明: specs/006-vps-ops/contracts/deploy.md

# さくらのAI Engine の APIキー
SAKURA_AI_API_KEY=

# GitHub App（007）。作り方: deploy/README.md、仕様: specs/007-github-intake/contracts/github-app.md
# App の ID（数字）
GITHUB_APP_ID=
# App の秘密鍵（PEM）のファイル。複数行なので値ではなく場所を書く。root:factory、0640 にする
GITHUB_APP_PRIVATE_KEY_PATH=/etc/sakura-factory/github-app.pem
# Webhook のシークレット（32 バイト以上の乱数。例: openssl rand -hex 32）。App の設定と同じ値
GITHUB_WEBHOOK_SECRET=
