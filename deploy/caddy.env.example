# /etc/caddy/caddy.env のひな形（root:caddy、0640）。値はリポジトリに書かず、VPS 上でだけ書く。
# 説明: specs/006-vps-ops/contracts/caddy.md

# ファクトリーのドメイン（例: factory.example.jp）。GitHub の Webhook の宛先になる
FACTORY_DOMAIN=
# ステージングのデモアプリのドメイン（例: staging.example.jp）
STAGING_DOMAIN=
# 本番は ACME（Let's Encrypt）の連絡先のメールアドレス。予行演習では internal
CADDY_TLS=
# 状況ページ（/status）の Basic 認証（011）。どちらも必須。空なら setup.sh が止まる
STATUS_USER=
# パスワードの bcrypt のハッシュ。平文は書かない。作り方: caddy hash-password（対話でパスワードを入れる）
# 出力の $ が展開されないよう、単一引用符で囲む（例: STATUS_PASSWORD_HASH='$2a$14$...'）
STATUS_PASSWORD_HASH=
